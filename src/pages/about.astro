---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import thisisme from '../assets/thisisme.png';

// 计算运行天数喵
const startDate = new Date('2026-01-24'); // 你可以在这里修改站点的“生日”
const today = new Date();
const diffTime = Math.abs(today.getTime() - startDate.getTime());
const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
---

<BaseLayout title="About | 关于" activeNav="about">
    <section>
        <h1>🧊 Hi there, I'm Igloos!</h1>
        
        <p>
            我叫<a href="https://zh.wikipedia.org/wiki/%E5%86%B0%E5%B1%8B">Igloos</a>, 该单词原意是用雪建造的圆顶小屋。你也可以直接叫我<span class="highlight">冰屋</span>！我不擅长自我介绍，要不此处省略1000字...
        </p>
        <p>
            曾经是数院半吊子，如今正在与大模型交手。被窝爱好者，周末全职在家照料被窝。偶尔也会烤一点难玩的<a href="https://igloomatics.vercel.app/dream">游戏</a>。极懒主义，白日梦冠军，喜欢猫，喜欢像素艺术，喜欢意识流文字。
        </p>
        <p>
            对这个世界所知尚浅，永远不会停止思考、探索、创造、共鸣。希望自己能永葆敏锐与好奇(*´∀ ˋ*)。
    </section>

    <!-- 折叠详情部分 -->

    <section class="about-section">
        <details>
            <summary>🏷 快速认识我 ...</summary>
            <div class="details-content">
                <ul>
                    <li>人类</li>
                    <li>INTJ-A</li>
                    <li>极懒主义</li>
                </ul>
            </div>
        </details>

        <details>
            <summary>🔮 关于这里 ...</summary>
            <div class="details-content">
                <p style="margin-bottom: 10px;">
                    该站点已运行 <span class="stat-number">{diffDays}</span> 天，共被造访过 <span id="busuanzi_container_site_uv" style="display:none;"><span id="busuanzi_value_site_uv" class="stat-number"></span></span> 次。<br>
                    本人线下无敌社恐，一直非常渴望在互联网上拥有自己的赛博小家(兴奋)！之前也一直喜欢捣鼓一些(乱七八糟的)东西，但只是自娱自乐，如今我可以在这里分享出来啦，践行开源精神！<br>
                    愿望是能做出有用的、好玩的、有影响力的东西。<br>
                    前端自己设计，采用Astro框架，Vercel服务器。
                </p>
                <ul>
                    <li>🎼 <a href="#">Music</a></li>
                    <li>🎮 <a href="#">Game</a></li>
                </ul>
            </div>
        </details>
        
        <details>
            <summary>🫧 异次元人设 ...</summary>
            <div class="details-content">
                感谢Nano Banana喵
                <div class="about-image-container">
                    <Image src={thisisme} alt="异次元人设" class="about-image" />
                </div>
            </div>
        </details>

        <details>
            <summary>🕊️ 在这里捉到我 ...</summary>
            <div class="details-content">
                <ul>
                    <li>Email: 还没有喵</li>
                    <li>GitHub: https://github.com/igloomatics</li>
                    <li>Twitter: 还没有喵</li>
                </ul>
            </div>
        </details>

        <details>
            <summary>🌎 语言系统 ...</summary>
            <div class="details-content">
                <ul>
                    <li>🇨🇳 中文</li>
                    <li>🇺🇸 English</li>
                    <li>🇯🇵 日本語 (Learning)</li>
                    <li>🇰🇷 한국어 (Learning)</li>
                </ul>
            </div>
        </details>

        <details>
            <summary>⭐ 我的技术栈 ...</summary>
            <div class="details-content">
                Git, GitHub, Python, C, C++, Markdown, LaTeX, Matlab, Unity, Godot, Cocos
            </div>
        </details>

        

        <details>
            <summary>🤍 朋友们 ...</summary>
            <div class="details-content">
                欢迎和大家交换友链QWQ <br>
                <a href="#">小羊</a> | <a href="#">大猫猫</a>
            </div> 
        </details>

        <details>
            <summary>🌱 Projects I'm currently working on ...</summary>
            <div class="details-content">
                Building a dream catcher for the web. <br>
                Refactoring my sleep schedule.
            </div>
        </details>
    </section>

    <div style="height: 100px;"></div>
</BaseLayout>

<style>
    h1 {
        font-size: 2.2rem;
        margin-bottom: 20px;
        color: var(--text-main);
        text-shadow: 0 2px 10px rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    p {
        font-size: 1rem; 
        margin-bottom: 15px;
        color: #555;
        line-height: 1.7;
        text-align: left;
        word-break: break-word;
    }

    .about-section { margin-top: 40px; }

    details {
        margin-bottom: 15px;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    details[open] {
        background: rgba(255, 255, 255, 0.6);
        box-shadow: 0 4px 15px rgba(185, 215, 234, 0.2);
    }

    summary {
        cursor: pointer;
        font-size: 1.1rem;
        font-weight: bold;
        color: var(--text-main);
        padding: 12px 15px;
        list-style: none;
        user-select: none;
        transition: color 0.2s;
        display: flex;
        align-items: center;
    }
    summary::-webkit-details-marker { display: none; }
    summary:hover { color: var(--col-4-dark); }

    .details-content {
        padding: 5px 20px 20px 45px;
        color: var(--text-main);
        font-size: 1rem;
        animation: fadeIn 0.4s ease;
    }
    .details-content ul { list-style: none; }
    .details-content li { margin-bottom: 8px; }
    .details-content li::before {
        content: "•"; color: var(--col-4-dark);
        font-weight: bold; display: inline-block; width: 1em; margin-left: -1em;
    }

    .about-image-container {
        margin: 10px 0;
        text-align: center;
    }

    .about-image {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(118, 159, 205, 0.15);
        border: 2px solid #fff;
    }

    .stat-number {
        color: var(--col-4-dark);
        font-weight: bold;
        font-family: monospace;
        font-size: 1.1rem;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
